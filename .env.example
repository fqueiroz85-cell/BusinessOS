# Supabase
# Valores em: Supabase Dashboard > Project Settings > API
# Copie este arquivo para .env.local e preencha com os valores do seu projeto.
NEXT_PUBLIC_SUPABASE_URL=https://SEU-PROJETO.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Geração de briefing por IA — dois provedores possíveis, escolhidos por
# BRIEFING_PROVIDER. Nenhum dos dois usa uma chave de API paga por token.

# BRIEFING_PROVIDER = "claude-code" (padrão) | "ollama"
# "claude-code": chama o Claude Code CLI (`claude -p`) já logado na sua
# assinatura Claude (Free/Pro/Max) — sem custo extra além da assinatura,
# mas consome a cota de uso dela. Requer o CLI instalado e logado
# ("claude auth status" deve mostrar loggedIn: true).
# "ollama": modelo local, 100% offline, zero cota de assinatura, mas mais
# lento e de menor qualidade (ver docs/agents-integration.md).
BRIEFING_PROVIDER=claude-code

# Usado apenas quando BRIEFING_PROVIDER=claude-code. Modelo mais barato/rápido
# por padrão (Haiku) — é uma tarefa curta de síntese de texto, chamada toda
# vez que alguém clica em "Gerar briefing", não vale gastar cota da
# assinatura com um modelo maior para isso.
CLAUDE_CLI_MODEL=haiku

# Modelo usado pelos agentes da Fase 3 (npm run agent:*). Sonnet é o meio-termo:
# acima do Haiku do briefing, abaixo do Opus. Cada agente manda o negócio inteiro
# no prompt, então rodar vários de uma vez consome cota de forma perceptível —
# Sonnet corta bem esse custo sem perder muito neste tipo de tarefa. Troque para
# "opus" quando quiser o máximo de qualidade. Ver docs/agents-integration.md.
AGENT_CLI_MODEL=sonnet

# URL do BusinessOS que os scripts de agente/skill consomem via HTTP.
# Eles rodam fora do processo Next.js, então precisam do servidor no ar.
BUSINESSOS_URL=http://localhost:3000

# Usados apenas quando BRIEFING_PROVIDER=ollama. Requer o Ollama rodando
# (https://ollama.com) com o modelo já baixado: ollama pull llama3.2:3b
# Em máquinas sem GPU dedicada, llama3.2:3b é o ponto de equilíbrio entre
# qualidade e velocidade; llama3.1:8b existe mas é bem mais lento em CPU.
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_MODEL=llama3.2:3b
